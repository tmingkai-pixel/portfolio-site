---
import AppShell from "../../layouts/AppShell.astro";
import StaggerGrid from "../../components/StaggerGrid.astro";
import { mediaPath } from "../../lib/works";
import about from "../../data/about.json";

// Everything here is edited in Pages CMS ("About page" → src/data/about.json)
const bio = (about.bio ?? []).filter(Boolean);
const photos = (about.photos ?? []).filter(Boolean).map((file: string, i: number, all: string[]) => ({
	src: mediaPath(file),
	alt: i === 0 ? `Portrait of ${about.name}` : `Photo ${i + 1} of ${all.length}`,
}));
const experience = (about.experience ?? []).map((job) => ({
	...job,
	roles: (job.roles ?? []).map((role) => ({ ...role, points: (role.points ?? []).filter(Boolean) })),
}));
const skills = [...(about.techSkills ?? []), ...(about.softSkills ?? [])].filter(Boolean);
---

<AppShell title="About" active="about" description={about.tagline} menuIndex={-1}>
	<Fragment slot="info">
		<section class="card">
			<h1 class="card-label">About</h1>
			<div class="bio">
				{bio.map((paragraph) => <p>{paragraph}</p>)}
			</div>
		</section>

		{/* CV details: scroll on their own so the column always fits */}
		<section class="scroll-box" aria-labelledby="cv-label">
			<h2 class="card-label scroll-box__label" id="cv-label">Experience</h2>
			<div class="scroll-box__body">
				{experience.map((job) => (
					<div class="cv-item">
						<h3 class="cv-title">{job.title}</h3>
						{job.roles.map((role) => (
							<div class="cv-role">
								<p class="cv-meta">{role.where} · {role.when}</p>
								<ul class="cv-points">{role.points.map((point) => <li>{point}</li>)}</ul>
							</div>
						))}
					</div>
				))}
				<h2 class="card-label cv-section">Education</h2>
				{(about.education ?? []).map((item) => (
					<div class="cv-item">
						<h3 class="cv-title">{item.title}</h3>
						<p class="cv-meta">{item.where} · {item.when}</p>
					</div>
				))}
				{skills.length > 0 && (
					<>
						<h2 class="card-label cv-section">Skills</h2>
						<p class="cv-item cv-skills">{skills.join(" · ")}</p>
					</>
				)}
			</div>
		</section>
	</Fragment>

	<StaggerGrid items={photos} eager />
</AppShell>

<style>
	.card {
		flex: 0 0 auto;
		margin-bottom: 1.8vw;
		border: 1px dashed var(--rule);
		padding: 0.75vw 0.7vw 0.9vw;
	}
	.card-label {
		display: block;
		margin: 0 0 0.45vw;
		color: var(--label);
		font-family: var(--font-mono);
		font-size: 0.72vw;
		font-weight: 400;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}
	.bio {
		font-size: 0.92vw;
		line-height: 1.2;
	}
	.bio p {
		margin: 0 0 1.1em;
	}
	.bio p:last-child {
		margin-bottom: 0;
	}

	/* Bottom section: hugs its contents and sits flush with the bottom of the
	   column; if it's taller than the space left, it fills it and scrolls */
	.scroll-box {
		flex: 0 1 auto;
		min-height: 0;
		display: flex;
		flex-direction: column;
		margin-top: auto;
		border: 1px dashed var(--rule);
	}
	.scroll-box__label {
		margin: 0;
		padding: 0.95vw 0.7vw;
		border-bottom: 1px dashed var(--rule);
	}
	.scroll-box__body::-webkit-scrollbar {
		display: none;
	}
	.scroll-box__body {
		flex: 1 1 auto;
		min-height: 0;
		overflow-y: auto;
		/* Scrolls without showing a scrollbar */
		scrollbar-width: none;
		font-size: 0.8vw;
		line-height: 1.4;
	}
	.cv-item {
		margin: 0;
		padding: 0.75vw 0.7vw;
		border-bottom: 1px dashed var(--rule);
	}
	.cv-title {
		margin: 0;
		color: var(--orange);
		font-size: 0.86vw;
		font-weight: 400;
	}
	.cv-role + .cv-role {
		margin-top: 0.6vw;
	}
	.cv-meta {
		margin: 0.25vw 0 0;
		color: var(--label);
		font-size: 0.72vw;
		text-transform: uppercase;
	}
	.cv-points {
		margin: 0.35vw 0 0;
		padding-left: 1.1em;
	}
	.cv-section {
		margin: 0;
		padding: 0.95vw 0.7vw;
		border-bottom: 1px dashed var(--rule);
	}

	@media (max-width: 899px) {
		.card {
			padding: 12px;
			margin-bottom: 16px;
		}
		.card-label {
			font-size: 11px;
			margin-bottom: 6px;
		}
		.bio {
			font-size: 15px;
		}
		.scroll-box {
			margin-top: 0;
		}
		.scroll-box__label,
		.cv-section,
		.cv-item {
			padding: 12px;
		}
		.scroll-box__body {
			max-height: 60vh;
			font-size: 13px;
		}
		.cv-title {
			font-size: 14px;
		}
		.cv-meta {
			font-size: 11px;
		}
	}
</style>
