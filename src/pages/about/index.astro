---
import Layout from "../../layouts/Layout.astro";
import Media from "../../components/Media.astro";

import { mediaPath } from "../../lib/works";
import about from "../../data/about.json";

// All text here is edited in Pages CMS ("About page" → src/data/about.json)
const { name, intro, email, linkedin } = about;
const techSkills = (about.techSkills ?? []).filter(Boolean);
const softSkills = (about.softSkills ?? []).filter(Boolean);
const education = about.education ?? [];
const experience = (about.experience ?? []).map((job) => ({
	...job,
	roles: (job.roles ?? []).map((role) => ({ ...role, points: (role.points ?? []).filter(Boolean) })),
}));
---

<Layout title="About" description="Tan Ming-Kai — graphic designer with 5+ years of experience, now studying Computer Science at SUSS.">
	<div class="about">
		<aside class="side">
			<h1 class="display">About</h1>

			<div class="card">
				<Media src={mediaPath(about.portrait || "/media/about/portrait.jpg")} alt={`Portrait of ${name}`} class="portrait" sizes="(max-width: 749px) 30vw, 15vw" widths={[200, 400, 600]} eager />
				<h2 class="name mono">{name}</h2>
				<p class="intro">{intro}</p>
			</div>

			<div class="links">
				<a class="pill" href={`mailto:${email}?subject=Hello!`}>Contact Me</a>
				<a class="pill" href={linkedin} target="_blank" rel="noopener">LinkedIn</a>
			</div>

			<div class="skills">
				<div>
					<h2 class="label">Tech skills</h2>
					<ul>{techSkills.map((s) => <li>{s}</li>)}</ul>
				</div>
				<div>
					<h2 class="label">Soft skills</h2>
					<ul>{softSkills.map((s) => <li>{s}</li>)}</ul>
				</div>
			</div>
		</aside>

		<div class="main">
			<section class="education">
				<h2 class="label">Education</h2>
				{education.map((item) => (
					<div class="entry">
						<h3>{item.title}</h3>
						<p class="meta mono">{item.where} • {item.when}</p>
					</div>
				))}
			</section>

			<section class="experience">
				<h2 class="label">Professional experience</h2>
				{experience.map((job) => (
					<div class="job">
						<h3 class="job-title">{job.title}</h3>
						{job.roles.map((role) => (
							<div class="role">
								<p class="meta mono">{role.where} • {role.when}</p>
								<ul class="points">{role.points.map((p) => <li>{p}</li>)}</ul>
							</div>
						))}
					</div>
				))}
			</section>
		</div>
	</div>
</Layout>

<style>
	/* Measured from the Wix About page (desktop values in vw) */
	.about {
		display: grid;
		grid-template-columns: 37.9vw 1fr;
		column-gap: 2.87vw;
		padding: 0.44vw 1.56vw 6vw 1.53vw;
	}

	/* ---------- Left column ---------- */
	.side h1 {
		font-size: 6.78vw; /* Wix sizes scaled to Inter's wider letters */
		font-weight: 700;
		margin-left: 0.29vw;
	}
	.card {
		position: relative;
		width: 35.03vw;
		height: 30.74vw;
		margin-top: 8.33vw;
		background: var(--navy);
		padding: 11.59vw 1.54vw 0;
	}
	.card :global(.portrait) {
		position: absolute;
		left: 17.68vw;
		top: -3.03vw;
		width: 14.86vw;
		height: 16.5vw;
		min-height: 0;
		object-fit: cover;
	}
	.name {
		color: var(--orange);
		font-size: 1.88vw;
		font-weight: 700;
		line-height: 1;
		margin: 0;
	}
	.intro {
		color: var(--orange);
		font-size: 2.22vw;
		line-height: 1;
		width: 31vw;
		margin: 3.17vw 0 0;
	}
	.links {
		display: grid;
		gap: 1.25vw;
		width: 35.37vw;
		margin-top: 1.15vw;
	}
	.pill {
		height: 3.44vw;
		font-size: 1.95vw;
		line-height: 1;
	}
	.skills {
		display: grid;
		grid-template-columns: 17.04vw 1fr;
		margin-top: 2.35vw;
	}
	.label {
		font-size: 1.41vw;
	}
	.skills ul {
		list-style: none;
		margin: 0.7vw 0 0;
		padding: 0;
		font-size: 1.36vw;
		line-height: 1.3;
	}

	/* ---------- Right column ---------- */
	.main {
		padding-top: 3.83vw;
	}
	.education {
		padding-left: 1.51vw;
		padding-bottom: 2.44vw;
		border-bottom: 1px solid var(--orange);
	}
	.entry {
		margin-top: 2.3vw;
	}
	.entry + .entry {
		margin-top: 2.21vw;
	}
	h3 {
		color: var(--orange);
		font-weight: 400;
		line-height: 1;
		margin: 0;
	}
	.entry h3 {
		font-size: 2.24vw;
	}
	.meta {
		font-size: 1.25vw;
		font-weight: 600;
		line-height: 1;
		margin: 0.33vw 0 0;
	}
	.experience {
		padding: 1.91vw 0 0 1.51vw;
	}
	.job {
		margin-top: 1.55vw;
	}
	.job + .job {
		margin-top: 3.57vw;
	}
	.job-title {
		font-size: 3vw;
	}
	.role .meta {
		margin-top: 1.9vw;
	}
	.role + .role .meta {
		margin-top: 2.6vw;
	}
	.points {
		list-style: none;
		margin: 0.5vw 0 0;
		padding: 0;
		font-size: 1.31vw;
		line-height: 1.355;
		max-width: 50.8vw;
	}
	.points li::before {
		content: "• ";
	}

	/* ---------- Phones ---------- */
	@media (max-width: 749px) {
		.about {
			grid-template-columns: 1fr;
			padding: 20px 20px 48px;
		}
		.side h1 {
			font-size: 19vw;
			margin: 0;
		}
		.card {
			width: 100%;
			height: auto;
			margin-top: 56px;
			padding: 24px 18px 22px;
		}
		.card :global(.portrait) {
			left: auto;
			right: 18px;
			top: -32px;
			width: 30%;
			height: auto;
			aspect-ratio: 95 / 106;
		}
		.name {
			font-size: 13.5px;
			margin-top: 60px;
		}
		.intro {
			width: auto;
			font-size: 19px;
			margin-top: 14px;
		}
		.links {
			width: 100%;
			gap: 10px;
			margin-top: 20px;
		}
		.pill {
			height: 40px;
			font-size: 15px;
		}
		.skills {
			grid-template-columns: 1fr 1fr;
			margin-top: 28px;
		}
		.label {
			font-size: 13.5px;
		}
		.skills ul,
		.points {
			font-size: 15.4px;
			margin-top: 6px;
			max-width: none;
		}
		.main {
			padding-top: 36px;
		}
		.education,
		.experience {
			padding-left: 0;
		}
		.education {
			padding-bottom: 28px;
		}
		.experience {
			padding-top: 28px;
		}
		.entry,
		.entry + .entry {
			margin-top: 16px;
		}
		.entry h3 {
			font-size: 20px;
		}
		.meta {
			font-size: 12.5px;
			margin-top: 4px;
		}
		.job,
		.job + .job {
			margin-top: 20px;
		}
		.job + .job {
			margin-top: 32px;
		}
		.job-title {
			font-size: 26px;
		}
		.role .meta,
		.role + .role .meta {
			margin-top: 12px;
		}
	}
</style>
