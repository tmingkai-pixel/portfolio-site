---
import { render } from "astro:content";
import AppShell from "../../layouts/AppShell.astro";
import Media from "../../components/Media.astro";
import StoryGroup from "../../components/StoryGroup.astro";
import StaggerGrid from "../../components/StaggerGrid.astro";
import { getAllWorks, getWorks, workMedia, pieceIds } from "../../lib/works";

// Every project (drafts included) gets a page; drafts are a private preview link
export async function getStaticPaths() {
	const works = await getAllWorks();
	return works.map((work) => ({ params: { id: work.id }, props: { work } }));
}

const { work } = Astro.props;
// Position in the Selected Works list (drafts aren't listed: treat as the bottom)
const listed = await getWorks();
const listedIndex = listed.findIndex((w) => w.id === work.id);
const menuIndex = listedIndex >= 0 ? listedIndex : listed.length;
const { Content } = await render(work);
const { data } = work;

const isCover = (file: string) => file === data.cover;
const isTabs = data.template === "tabs" && data.pieces.length > 0;

// Tabs projects: one entry per piece (its own photos), switched from column 2
const ids = pieceIds(data.pieces.map((p) => p.title));
const pieces = isTabs
	? data.pieces.map((piece, i) => ({
			...piece,
			id: ids[i],
			items: piece.media.filter((file) => !isCover(file)).map((file, n, all) => ({
				src: workMedia(work.id, file),
				alt: `${piece.title} (${n + 1} of ${all.length})`,
				sound: data.sound.includes(file),
			})),
		}))
	: [];

// Standard projects: story groups (headings + captions) when present,
// otherwise the plain Gallery, in two staggered columns. The cover leads.
const story = isTabs
	? []
	: data.story
			.map((group) => ({
				...group,
				rows: group.rows
					.map((row) => ({ ...row, images: row.images.filter((img) => !isCover(img.src)) }))
					.filter((row) => row.images.length > 0),
			}))
			.filter((group) => group.rows.length > 0);
const galleryItems = isTabs || story.length
	? []
	: [data.cover, ...data.gallery.filter((file) => !isCover(file))].map((file, i, all) => ({
			src: workMedia(work.id, file),
			alt: i === 0 && data.coverAlt ? data.coverAlt : `${data.title}, photo ${i + 1} of ${all.length}`,
			sound: data.sound.includes(file),
		}));

const details: [string, string | null | undefined][] = [
	["Date", data.date],
	["Project type", data.projectType ?? data.category],
];
---

<AppShell title={data.title} description={data.summary} active={work.id} noindex={data.draft} menuIndex={menuIndex}>
	{data.draft && (
		<p slot="before" class="draft-banner">
			Draft preview: only people with this link can see it. Untick “Draft” to publish.
		</p>
	)}

	<Fragment slot="info">
		<div class="info-head">
			<h1 class="title-chip">{data.title}</h1>
			<div class="card">
				<section class="card-row">
					<h2 class="card-label">In short</h2>
					<p class="card-text card-text--lead">{data.summary}</p>
				</section>
				<dl class="card-row card-grid">
					{details.filter(([, value]) => value).map(([label, value]) => (
						<div>
							<dt class="card-label">{label}</dt>
							<dd class="card-text">{value}</dd>
						</div>
					))}
				</dl>
				<dl class="card-row">
					<dt class="card-label">Role</dt>
					<dd class="card-text">{data.role}</dd>
				</dl>
				{data.doneUnder && (
					<dl class="card-row">
						<dt class="card-label">Done under</dt>
						<dd class="card-text">{data.doneUnder}</dd>
					</dl>
				)}
				{isTabs && pieces.map((piece, i) => (
					<section class="card-row card-row--piece" data-piece-info={piece.id} hidden={i !== 0}>
						<h2 class="piece-name">{piece.title}</h2>
						{piece.caption && <p class="card-text">{piece.caption}</p>}
					</section>
				))}
			</div>
		</div>

		{/* Bottom section: scrolls on its own so it always fits */}
		{isTabs ? (
			<section class="scroll-box" aria-labelledby="pieces-label">
				<h2 class="card-label scroll-box__label" id="pieces-label">Pieces <span class="count">{pieces.length}</span></h2>
				<div class="scroll-box__body pieces" role="tablist" aria-labelledby="pieces-label">
					{pieces.map((piece, i) => (
						<button type="button" role="tab" class="piece-tab" data-piece-tab={piece.id} aria-controls={piece.id} aria-selected={i === 0 ? "true" : "false"}>
							{piece.title}
						</button>
					))}
				</div>
			</section>
		) : (
			<section class="scroll-box" aria-labelledby="about-label">
				<h2 class="card-label scroll-box__label" id="about-label">About the project</h2>
				<div class="scroll-box__body about-text"><Content /></div>
			</section>
		)}
	</Fragment>

	{isTabs && pieces.map((piece, i) => (
		<StaggerGrid items={piece.items} eager={i === 0} id={piece.id} data-piece={piece.id} role="tabpanel" aria-label={piece.title} hidden={i !== 0} />
	))}

	{story.length > 0 && (
		<>
			<Media
				src={workMedia(work.id, data.cover)}
				alt={data.coverAlt || data.title}
				class="cover"
				sound={data.sound.includes(data.cover)}
				sizes="(max-width: 899px) 100vw, 52vw"
				lightbox
				eager
			/>
			{story.map((group) => (
				<StoryGroup workId={work.id} title={data.title} sound={data.sound} {...group} />
			))}
		</>
	)}

	{galleryItems.length > 0 && <StaggerGrid items={galleryItems} eager />}
</AppShell>

<style>
	.draft-banner {
		margin: 0;
		background: var(--navy);
		color: #fff;
		font-family: var(--font-mono);
		font-size: 13px;
		padding: 10px 16px;
	}

	/* ---------- Column 2 (desktop values in vw, from the reference designs) ---------- */
	.info-head {
		flex: 0 0 auto;
		margin-bottom: 1.8vw;
	}
	.title-chip {
		display: inline-block;
		margin: 0 0 0 0;
		padding: 0.45vw 0.7vw 0.35vw;
		background: var(--orange);
		color: #fff;
		font-family: var(--font-sans);
		font-size: 1.25vw;
		font-weight: 400;
		letter-spacing: -0.01em;
		line-height: 1.1;
	}
	.card {
		border: 1px dashed var(--rule);
	}
	.card-row {
		margin: 0;
		padding: 0.75vw 0.7vw 0.9vw;
	}
	.card-row + .card-row {
		border-top: 1px dashed var(--rule);
	}
	.card-row[hidden] {
		display: none;
	}
	.card-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		padding: 0;
	}
	.card-grid > div {
		padding: 0.75vw 0.7vw 0.9vw;
	}
	.card-grid > div + div {
		border-left: 1px dashed var(--rule);
	}
	.card-label {
		display: block;
		margin: 0 0 0.45vw;
		color: var(--label);
		font-family: var(--font-mono);
		font-size: 0.72vw;
		font-weight: 400;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}
	.card-text {
		margin: 0;
		font-size: 0.86vw;
		line-height: 1.25;
	}
	.card-text--lead {
		font-size: 0.92vw;
	}
	dd {
		margin: 0;
	}
	.piece-name {
		margin: 0 0 0.5vw;
		color: var(--orange);
		font-size: 0.72vw;
		font-weight: 400;
	}

	/* Bottom section of column 2: fills the remaining height and scrolls */
	/* Bottom section: hugs its contents and sits flush with the bottom of the
	   column; if it's taller than the space left, it fills it and scrolls */
	.scroll-box {
		flex: 0 1 auto;
		min-height: 0;
		display: flex;
		flex-direction: column;
		margin-top: auto;
		border: 1px dashed var(--rule);
	}
	.scroll-box__label {
		margin: 0;
		padding: 0.95vw 0.7vw;
		border-bottom: 1px dashed var(--rule);
	}
	.count {
		margin-left: 0.4em;
		color: var(--orange);
	}
	.scroll-box__body::-webkit-scrollbar {
		display: none;
	}
	.scroll-box__body {
		flex: 1 1 auto;
		min-height: 0;
		overflow-y: auto;
		/* Scrolls without showing a scrollbar */
		scrollbar-width: none;
	}
	.about-text {
		padding: 0.75vw 0.7vw;
		font-size: 0.86vw;
		line-height: 1.45;
	}
	.about-text :global(p) {
		margin: 0 0 0.9em;
	}
	.about-text :global(p:last-child) {
		margin-bottom: 0;
	}

	/* Pieces: two columns of names divided by dashed lines; the selected one is orange */
	.pieces {
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-content: start;
	}
	.piece-tab {
		min-height: 2.4vw;
		padding: 0.55vw 0.7vw;
		border: 0;
		border-bottom: 1px dashed var(--rule);
		background: none;
		color: var(--navy);
		font-family: var(--font-mono);
		font-size: 0.72vw;
		line-height: 1.25;
		text-align: left;
		cursor: pointer;
		overflow-wrap: anywhere;
	}
	.piece-tab:nth-child(odd) {
		border-right: 1px dashed var(--rule);
	}
	.piece-tab:hover {
		color: var(--orange);
	}
	.piece-tab[aria-selected="true"] {
		background: var(--orange);
		color: #fff;
	}
	.piece-tab:focus-visible {
		outline: 2px solid var(--navy);
		outline-offset: -3px;
	}

	/* ---------- Image area ---------- */
	.cover,
	:global(.images .cover img) {
		display: block;
		width: 100%;
		height: auto;
	}

	/* ---------- Phones ---------- */
	@media (max-width: 899px) {
		.title-chip {
			font-size: 20px;
			padding: 6px 10px 5px;
		}
		.card-row,
		.card-grid > div {
			padding: 10px 12px 12px;
		}
		.card-grid {
			padding: 0;
		}
		.card-label {
			font-size: 11px;
			margin-bottom: 5px;
		}
		.card-text {
			font-size: 14px;
		}
		.card-text--lead {
			font-size: 15px;
		}
		.piece-name {
			font-size: 12px;
		}
		.info-head {
			margin-bottom: 16px;
		}
		.scroll-box {
			margin-top: 0;
			min-height: 0;
		}
		.scroll-box__label {
			padding: 12px;
		}
		.scroll-box__body {
			max-height: 50vh;
		}
		.about-text {
			padding: 12px;
			font-size: 14px;
		}
		.piece-tab {
			min-height: 44px;
			padding: 10px 12px;
			font-size: 13px;
		}
	}
</style>

<script>
	// Tabs projects: the Pieces list (column 2) switches which piece's photos show,
	// and which blurb shows in the info card. Opens on the first piece; #piece links work.
	const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-piece-tab]")];
	const panels = [...document.querySelectorAll<HTMLElement>("[data-piece]")];
	const blurbs = [...document.querySelectorAll<HTMLElement>("[data-piece-info]")];
	if (tabs.length && panels.length) {
		const select = (id: string, updateUrl: boolean) => {
			for (const tab of tabs) tab.setAttribute("aria-selected", String(tab.dataset.pieceTab === id));
			for (const panel of panels) panel.hidden = panel.dataset.piece !== id;
			for (const blurb of blurbs) blurb.hidden = blurb.dataset.pieceInfo !== id;
			for (const video of document.querySelectorAll<HTMLVideoElement>("[data-piece][hidden] video")) video.pause();
			if (updateUrl) history.replaceState(null, "", `#${id}`);
			// Show the new piece's photos from the top
			const panel = panels.find((p) => p.dataset.piece === id);
			if (panel && panel.getBoundingClientRect().top < 0) scrollTo({ top: 0 });
		};
		for (const tab of tabs) {
			tab.addEventListener("click", () => select(tab.dataset.pieceTab!, true));
		}
		const openFromHash = () => {
			const id = decodeURIComponent(location.hash.slice(1));
			if (id && panels.some((p) => p.dataset.piece === id)) {
				select(id, false);
				tabs.find((t) => t.dataset.pieceTab === id)?.scrollIntoView({ block: "nearest" });
			}
		};
		openFromHash();
		addEventListener("hashchange", openFromHash);
	}
</script>
