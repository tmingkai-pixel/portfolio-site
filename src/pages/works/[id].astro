---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Media from "../../components/Media.astro";
import { getAllWorks, getWorks, workMedia } from "../../lib/works";

// Drafts get a page too (a private preview link), but only listed works
// appear in the previous/next links.
export async function getStaticPaths() {
	const [all, listed] = await Promise.all([getAllWorks(), getWorks()]);
	return all.map((work) => {
		const i = listed.findIndex((w) => w.id === work.id);
		return {
			params: { id: work.id },
			props: { work, prev: i > 0 ? listed[i - 1] : undefined, next: i >= 0 ? listed[i + 1] : undefined },
		};
	});
}

const { work, prev, next } = Astro.props;
const { Content } = await render(work);
const { data } = work;
const base = import.meta.env.BASE_URL;

// "Tabs" template: one tab per piece. Each tab gets a URL-friendly id for #links.
const slugify = (text: string) =>
	text.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || "piece";
const usedIds = new Set<string>();
const pieces = data.template === "tabs"
	? data.pieces.map((piece) => {
			let id = slugify(piece.title);
			for (let n = 2; usedIds.has(id); n++) id = `${slugify(piece.title)}-${n}`;
			usedIds.add(id);
			return { ...piece, id };
		})
	: [];

const details = [
	["Role", data.role],
	["Date", data.date],
	["Project type", data.projectType ?? data.category],
	["Done under", data.doneUnder],
].filter(([, value]) => value);
---

<Layout title={data.title} description={data.summary} noindex={data.draft}>
	{data.draft && (
		<p class="draft-banner mono">
			Draft preview: only people with this link can see it. Untick “Draft” to publish.
		</p>
	)}
	<article>
		<div class="intro">
			<div class="text">
				<h1 class="display">{data.title}</h1>
				<div class="body"><Content /></div>

				<dl>
					{details.map(([label, value]) => (
						<div>
							<dt class="label">{label}</dt>
							<dd>{value}</dd>
						</div>
					))}
				</dl>
			</div>
			<Media src={workMedia(work.id, data.cover)} alt={data.title} class="cover" sound={data.sound.includes(data.cover)} eager />
		</div>

		{pieces.length > 0 ? (
			<div class="pieces" data-pieces>
				<div class="piece-tabs" role="tablist" aria-label={`${data.title} pieces`}>
					<button type="button" role="tab" class="piece-tab mono" data-piece-tab="all" aria-selected="true">All</button>
					{pieces.map((piece) => (
						<button type="button" role="tab" class="piece-tab mono" data-piece-tab={piece.id} aria-selected="false" aria-controls={piece.id}>
							{piece.title}
						</button>
					))}
				</div>
				<div class="piece-panels">
				{pieces.map((piece) => (
					<section class="piece" id={piece.id} data-piece={piece.id} role="tabpanel" aria-label={piece.title}>
						<header class="piece-header">
							<h2 class="piece-title">{piece.title}</h2>
							{piece.caption && <p class="piece-caption">{piece.caption}</p>}
						</header>
						{piece.media.length > 0 && (
							<div class="gallery">
								{piece.media.map((file, i) => (
									<Media src={workMedia(work.id, file)} alt={`${piece.title}, image ${i + 1}`} class="shot" sound={data.sound.includes(file)} />
								))}
							</div>
						)}
					</section>
				))}
				</div>
			</div>
		) : data.gallery.length > 0 && (
			<div class="gallery">
				{data.gallery.map((file, i) => (
					<Media src={workMedia(work.id, file)} alt={`${data.title}, image ${i + 1}`} class="shot" sound={data.sound.includes(file)} />
				))}
			</div>
		)}

		<nav class="pager mono" aria-label="More works">
			{prev ? <a href={`${base}works/${prev.id}/`}>Previous: {prev.data.title}</a> : <span />}
			{next && <a href={`${base}works/${next.id}/`}>Next: {next.data.title}</a>}
		</nav>
	</article>
</Layout>

<style>
	/* Measured from the Wix project pages (desktop values in vw) */
	article {
		padding: 0.98vw 0.94vw 3vw;
	}
	.draft-banner {
		margin: 0;
		background: var(--navy);
		color: #fff;
		border-top: 2px dashed var(--orange);
		font-size: 1vw;
		font-weight: 600;
		padding: 0.8vw 1.56vw;
	}
	.intro {
		display: grid;
		grid-template-columns: 43.75vw 48.59vw;
		justify-content: space-between;
		padding-left: 2.19vw;
	}
	.text {
		padding-top: 3.75vw;
	}
	h1 {
		font-size: 6.03vw; /* Wix sizes scaled to Inter's wider letters */
		line-height: 0.96;
	}
	.body {
		font-size: 1.77vw;
		line-height: 1.33;
		margin-top: 4.69vw;
	}
	.body :global(p) {
		margin: 0 0 1.25em;
	}
	.body :global(p:last-child) {
		margin-bottom: 0;
	}
	dl {
		margin: 3.12vw 0 0;
	}
	dl div {
		border-top: 1px solid var(--orange);
		min-height: 5.77vw;
		padding-top: 1.01vw;
	}
	dt {
		font-size: 1.17vw;
		line-height: 1.4;
	}
	dd {
		margin: 0;
		font-size: 1.47vw;
		line-height: 1.49;
	}
	.intro :global(.cover) {
		width: 100%;
		height: auto;
		align-self: start;
	}
	.intro :global(img.cover) {
		aspect-ratio: auto;
	}
	.gallery {
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: start;
		gap: 0.94vw;
		margin-top: 0.94vw;
	}
	.gallery :global(.shot) {
		width: 100%;
		height: auto;
	}
	.gallery :global(img.shot) {
		aspect-ratio: auto;
	}
	/* ---------- "Tabs" template: a navy sidebar of tabs on the left, styled like the site nav ---------- */
	.pieces {
		display: grid;
		grid-template-columns: 18vw 1fr;
		align-items: start;
		margin: 0.94vw -0.94vw 0;
		/* Navy runs the full height of the tab column while the tabs themselves stay pinned */
		background: linear-gradient(to right, var(--navy) 18vw, transparent 18vw);
	}
	.piece-tabs {
		position: sticky;
		top: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.2vw;
		max-height: 100vh;
		overflow-y: auto;
		scrollbar-width: none;
		padding: 1.56vw 0 1.56vw 1.56vw;
	}
	.piece-tabs::-webkit-scrollbar {
		display: none;
	}
	.piece-tab {
		flex: 0 0 auto;
		width: 100%;
		height: 2.2vw;
		padding: 0 1.1vw;
		border: 0;
		/* Rounded on the left, open on the right where it meets the content */
		border-radius: 1.1vw 0 0 1.1vw;
		background: var(--orange);
		color: var(--navy);
		font-size: 1.094vw;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-align: left;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		cursor: pointer;
		transition: background-color 0.15s ease;
	}
	.piece-tab:hover {
		background: #f0901f;
	}
	.piece-tab[aria-selected="true"] {
		background: var(--bg);
	}
	.piece-panels {
		min-width: 0;
		padding: 0 0.94vw 0 1.88vw;
	}
	.piece {
		padding-top: 1.56vw;
	}
	.piece + .piece {
		padding-top: 3vw;
	}
	.piece[hidden] {
		display: none;
	}
	.piece-header {
		padding: 0 0 1.25vw;
	}
	.piece-title {
		margin: 0;
		color: var(--orange);
		font-size: 3vw;
		font-weight: 400;
		letter-spacing: -0.02em;
		line-height: 1;
	}
	.piece-caption {
		margin: 0.6vw 0 0;
		max-width: 43.75vw;
		font-size: 1.47vw;
		line-height: 1.4;
	}
	.piece .gallery {
		margin-top: 0;
	}

	.pager {
		display: flex;
		justify-content: space-between;
		gap: 2vw;
		margin-top: 3vw;
		padding: 0 1.71vw;
		font-size: 1.25vw;
		font-weight: 600;
	}
	.pager a {
		color: var(--orange);
		text-decoration: none;
	}
	.pager a:hover {
		text-decoration: underline;
	}

	/* ---------- Phones: cover first, then the text ---------- */
	@media (max-width: 749px) {
		article {
			padding: 38px 19px 40px;
		}
		.draft-banner {
			font-size: 11px;
			padding: 10px 19px;
		}
		.intro {
			grid-template-columns: 1fr;
			padding: 0;
		}
		.intro :global(.cover) {
			grid-row: 1;
		}
		.text {
			padding-top: 39px;
		}
		h1 {
			font-size: 8.72vw;
		}
		.body {
			font-size: 5.13vw;
			margin-top: 38px;
		}
		dl {
			margin-top: 40px;
		}
		dl div {
			min-height: 0;
			padding: 10px 0 14px;
		}
		dt {
			font-size: 4.1vw;
		}
		dd {
			font-size: 4.6vw;
		}
		.gallery {
			grid-template-columns: 1fr;
			gap: 12px;
			margin-top: 40px;
		}
		/* Phones: not enough width for a sidebar, so the tabs become a scrolling strip on top */
		.pieces {
			grid-template-columns: 1fr;
			margin: 0 -19px;
			background: none;
		}
		.piece-tabs {
			background: var(--navy);
		}
		.piece-tabs {
			position: static;
			flex-direction: row;
			align-items: flex-end;
			gap: 3px;
			max-height: none;
			overflow-x: auto;
			overflow-y: hidden;
			padding: 12px 19px 0;
		}
		.piece-tab {
			width: auto;
			height: 32px;
			padding: 0 14px;
			border-radius: 14px 14px 0 0;
			font-size: 12px;
			overflow: visible;
		}
		.piece-panels {
			padding: 0 19px;
		}
		.piece,
		.piece + .piece {
			padding-top: 28px;
		}
		.piece-header {
			padding: 0 0 14px;
		}
		.piece-title {
			font-size: 24px;
		}
		.piece-caption {
			max-width: none;
			margin-top: 6px;
			font-size: 15px;
		}
		.pager {
			flex-direction: column;
			gap: 12px;
			margin-top: 36px;
			padding: 0;
			font-size: 13px;
		}
	}
</style>

<script>
	// "Tabs" template: show one piece at a time, or all of them
	for (const root of document.querySelectorAll<HTMLElement>("[data-pieces]")) {
		const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-piece-tab]")];
		const panels = [...root.querySelectorAll<HTMLElement>("[data-piece]")];

		const select = (id: string, updateUrl: boolean) => {
			for (const tab of tabs) tab.setAttribute("aria-selected", String(tab.dataset.pieceTab === id));
			for (const panel of panels) panel.hidden = id !== "all" && panel.dataset.piece !== id;
			// Pause videos in hidden pieces
			for (const video of root.querySelectorAll<HTMLVideoElement>(".piece[hidden] video")) video.pause();
			if (updateUrl) history.replaceState(null, "", id === "all" ? location.pathname + location.search : `#${id}`);
		};

		for (const tab of tabs) {
			tab.addEventListener("click", () => {
				select(tab.dataset.pieceTab!, true);
				tab.scrollIntoView({ block: "nearest", inline: "nearest" });
				// Jump back to the top of the pieces so the newly shown piece is in view
				if (root.getBoundingClientRect().top < 0) root.scrollIntoView();
			});
		}

		// Open a piece straight from a link like /works/one-thing-a-day/#candies
		const openFromHash = () => {
			const id = decodeURIComponent(location.hash.slice(1));
			if (id && panels.some((p) => p.dataset.piece === id)) {
				select(id, false);
				root.scrollIntoView();
			}
		};
		openFromHash();
		addEventListener("hashchange", openFromHash);
	}
</script>
