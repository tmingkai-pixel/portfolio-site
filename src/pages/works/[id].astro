---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Media from "../../components/Media.astro";
import { getAllWorks, getWorks, workMedia } from "../../lib/works";

// Drafts get a page too (a private preview link), but only listed works
// appear in the previous/next links.
export async function getStaticPaths() {
	const [all, listed] = await Promise.all([getAllWorks(), getWorks()]);
	return all.map((work) => {
		const i = listed.findIndex((w) => w.id === work.id);
		return {
			params: { id: work.id },
			props: { work, prev: i > 0 ? listed[i - 1] : undefined, next: i >= 0 ? listed[i + 1] : undefined },
		};
	});
}

const { work, prev, next } = Astro.props;
const { Content } = await render(work);
const { data } = work;
const base = import.meta.env.BASE_URL;

const details = [
	["Role", data.role],
	["Date", data.date],
	["Project type", data.projectType ?? data.category],
	["Done under", data.doneUnder],
].filter(([, value]) => value);
---

<Layout title={data.title} description={data.summary} noindex={data.draft}>
	{data.draft && (
		<p class="draft-banner mono">
			Draft preview: only people with this link can see it. Untick “Draft” to publish.
		</p>
	)}
	<article>
		<div class="intro">
			<div class="text">
				<h1 class="display">{data.title}</h1>
				<div class="body"><Content /></div>

				<dl>
					{details.map(([label, value]) => (
						<div>
							<dt class="label">{label}</dt>
							<dd>{value}</dd>
						</div>
					))}
				</dl>
			</div>
			<Media src={workMedia(work.id, data.cover)} alt={data.title} class="cover" sound={data.sound.includes(data.cover)} eager />
		</div>

		{data.gallery.length > 0 && (
			<div class="gallery">
				{data.gallery.map((file, i) => (
					<Media src={workMedia(work.id, file)} alt={`${data.title}, image ${i + 1}`} class="shot" sound={data.sound.includes(file)} />
				))}
			</div>
		)}

		<nav class="pager mono" aria-label="More works">
			{prev ? <a href={`${base}works/${prev.id}/`}>Previous: {prev.data.title}</a> : <span />}
			{next && <a href={`${base}works/${next.id}/`}>Next: {next.data.title}</a>}
		</nav>
	</article>
</Layout>

<style>
	/* Measured from the Wix project pages (desktop values in vw) */
	article {
		padding: 0.98vw 0.94vw 3vw;
	}
	.draft-banner {
		margin: 0;
		background: var(--navy);
		color: #fff;
		border-top: 2px dashed var(--orange);
		font-size: 1vw;
		font-weight: 600;
		padding: 0.8vw 1.56vw;
	}
	.intro {
		display: grid;
		grid-template-columns: 43.75vw 48.59vw;
		justify-content: space-between;
		padding-left: 2.19vw;
	}
	.text {
		padding-top: 3.75vw;
	}
	h1 {
		font-size: 6.03vw; /* Wix sizes scaled to Inter's wider letters */
		line-height: 0.96;
	}
	.body {
		font-size: 1.77vw;
		line-height: 1.33;
		margin-top: 4.69vw;
	}
	.body :global(p) {
		margin: 0 0 1.25em;
	}
	.body :global(p:last-child) {
		margin-bottom: 0;
	}
	dl {
		margin: 3.12vw 0 0;
	}
	dl div {
		border-top: 1px solid var(--orange);
		min-height: 5.77vw;
		padding-top: 1.01vw;
	}
	dt {
		font-size: 1.17vw;
		line-height: 1.4;
	}
	dd {
		margin: 0;
		font-size: 1.47vw;
		line-height: 1.49;
	}
	.intro :global(.cover) {
		width: 100%;
		height: auto;
		align-self: start;
	}
	.intro :global(img.cover) {
		aspect-ratio: auto;
	}
	.gallery {
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: start;
		gap: 0.94vw;
		margin-top: 0.94vw;
	}
	.gallery :global(.shot) {
		width: 100%;
		height: auto;
	}
	.gallery :global(img.shot) {
		aspect-ratio: auto;
	}
	.pager {
		display: flex;
		justify-content: space-between;
		gap: 2vw;
		margin-top: 3vw;
		padding: 0 1.71vw;
		font-size: 1.25vw;
		font-weight: 600;
	}
	.pager a {
		color: var(--orange);
		text-decoration: none;
	}
	.pager a:hover {
		text-decoration: underline;
	}

	/* ---------- Phones: cover first, then the text ---------- */
	@media (max-width: 749px) {
		article {
			padding: 38px 19px 40px;
		}
		.draft-banner {
			font-size: 11px;
			padding: 10px 19px;
		}
		.intro {
			grid-template-columns: 1fr;
			padding: 0;
		}
		.intro :global(.cover) {
			grid-row: 1;
		}
		.text {
			padding-top: 39px;
		}
		h1 {
			font-size: 8.72vw;
		}
		.body {
			font-size: 5.13vw;
			margin-top: 38px;
		}
		dl {
			margin-top: 40px;
		}
		dl div {
			min-height: 0;
			padding: 10px 0 14px;
		}
		dt {
			font-size: 4.1vw;
		}
		dd {
			font-size: 4.6vw;
		}
		.gallery {
			grid-template-columns: 1fr;
			gap: 12px;
			margin-top: 40px;
		}
		.pager {
			flex-direction: column;
			gap: 12px;
			margin-top: 36px;
			padding: 0;
			font-size: 13px;
		}
	}
</style>
