---
import Layout from "../../layouts/Layout.astro";
import Media from "../../components/Media.astro";
import { getWorks, workMedia } from "../../lib/works";
import { categories } from "../../lib/categories";

const base = import.meta.env.BASE_URL;
const works = await getWorks();
const filters = ["All", ...categories];
---

<Layout title="Works">
	<div class="works">
		<div class="filters" role="group" aria-label="Filter by category">
			{filters.map((f) => (
				<button type="button" class="filter mono" data-filter={f} aria-pressed={f === "All" ? "true" : "false"}>
					{f}
				</button>
			))}
		</div>

		<ol class="list">
			{works.map((work, i) => (
				<li data-category={work.data.category}>
					<a href={`${base}works/${work.id}/`}>
						<span class="num mono">{String(i + 1).padStart(2, "0")}</span>
						<span class="title display">
							{work.data.title}
							{work.data.draft && <span class="draft mono">Draft</span>}
						</span>
						<Media src={workMedia(work.id, work.data.cover)} alt="" class="thumb" />
					</a>
				</li>
			))}
		</ol>

		<p class="empty" data-empty hidden>Nothing here yet. Check back soon.</p>
	</div>
</Layout>

<style>
	/* Measured from the Wix Works page (desktop values in vw) */
	.works {
		padding: 1.6vw 0 1.3vw;
	}
	/* Category filter: not on the Wix site, kept small so the list looks the same */
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5vw;
		padding: 0 1.56vw;
		margin-bottom: 1.9vw;
	}
	.filter {
		font-size: 0.9vw;
		font-weight: 600;
		color: var(--orange);
		background: transparent;
		border: 1px solid var(--orange);
		border-radius: 999px;
		padding: 0.35vw 0.9vw;
		cursor: pointer;
	}
	.filter[aria-pressed="true"] {
		background: var(--orange);
		color: var(--bg);
	}
	.list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.list li {
		position: relative;
	}
	.list a {
		display: block;
		position: relative;
		padding: 1.56vw 0 3.12vw;
		text-decoration: none;
	}
	.num {
		position: absolute;
		left: 1.56vw;
		top: 0;
		color: var(--orange);
		font-size: 2.34vw;
		font-weight: 600;
		letter-spacing: 0;
		line-height: 1;
	}
	.title {
		display: block;
		margin-left: 6.88vw;
		width: 70.63vw;
		font-size: 6vw; /* Wix 6.25vw in Neue Haas; Inter is ~4% wider */
		font-weight: 800;
		letter-spacing: -0.01em;
		transition: color 0.15s ease;
	}
	.list a:hover .title {
		color: var(--navy);
	}
	.draft {
		font-size: 1vw;
		letter-spacing: 0;
		vertical-align: middle;
		color: var(--navy);
		border: 1px dashed var(--navy);
		border-radius: 999px;
		padding: 0.15vw 0.6vw;
	}
	/* Thumbnails scattered down the right side, in the same pattern as Wix */
	.list a :global(.thumb) {
		position: absolute;
		top: 0;
		right: var(--right, 5.93vw);
		width: var(--w, 3.44vw);
		height: auto;
		min-height: 0;
	}
	.list a :global(img.thumb) {
		aspect-ratio: auto;
	}
	.list a :global(.placeholder.thumb) {
		aspect-ratio: 4 / 3;
	}
	.list a :global(.placeholder.thumb span) {
		display: none;
	}
	.list li:nth-child(6n + 1) { --w: 3.44vw; --right: 5.93vw; }
	.list li:nth-child(6n + 2) { --w: 3.44vw; --right: 8.93vw; }
	.list li:nth-child(6n + 3) { --w: 4.3vw; --right: 1.56vw; }
	.list li:nth-child(6n + 4) { --w: 10.32vw; --right: 2.96vw; }
	.list li:nth-child(6n + 5) { --w: 9.37vw; --right: 1.6vw; }
	.list li:nth-child(6n) { --w: 10.32vw; --right: 7.91vw; }
	.empty {
		color: var(--orange);
		font-size: 2.34vw;
		padding: 0 1.56vw;
	}

	/* ---------- Phones: image on top, title below, number on the right ---------- */
	@media (max-width: 749px) {
		.works {
			padding: 24px 23px 40px;
		}
		.filters {
			gap: 6px;
			padding: 0;
			margin-bottom: 28px;
		}
		.filter {
			font-size: 11px;
			padding: 4px 10px;
		}
		.list li + li {
			margin-top: 77px;
		}
		.list a {
			display: grid;
			grid-template-columns: 1fr auto;
			column-gap: 12px;
			padding: 0;
		}
		.list a :global(.thumb) {
			position: static;
			grid-column: 1 / -1;
			grid-row: 1;
			width: 100%;
		}
		.num {
			position: static;
			grid-column: 2;
			grid-row: 2;
			font-size: 5.64vw;
			margin-top: 19px;
		}
		.title {
			grid-column: 1;
			grid-row: 2;
			width: auto;
			margin: 19px 0 0;
			font-size: 8.72vw;
		}
		.draft {
			font-size: 10px;
		}
		.empty {
			font-size: 18px;
			padding: 0;
		}
	}
</style>

<script>
	const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")];
	const items = [...document.querySelectorAll<HTMLElement>("[data-category]")];
	const empty = document.querySelector<HTMLElement>("[data-empty]")!;

	function apply(filter: string) {
		let shown = 0;
		for (const item of items) {
			const match = filter === "All" || item.dataset.category === filter;
			item.hidden = !match;
			if (match) shown++;
		}
		for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.filter === filter));
		empty.hidden = shown > 0;
	}

	for (const b of buttons) {
		b.addEventListener("click", () => {
			const filter = b.dataset.filter!;
			apply(filter);
			const url = new URL(location.href);
			if (filter === "All") url.searchParams.delete("category");
			else url.searchParams.set("category", filter);
			history.replaceState(null, "", url);
		});
	}

	// Allow linking straight to a category, e.g. /works/?category=3D%20Printing
	const initial = new URLSearchParams(location.search).get("category");
	if (initial && buttons.some((b) => b.dataset.filter === initial)) apply(initial);
</script>
