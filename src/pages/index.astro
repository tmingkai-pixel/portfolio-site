---
import Layout from "../layouts/Layout.astro";
import Media from "../components/Media.astro";
import { getWorks, workMedia } from "../lib/works";

const base = import.meta.env.BASE_URL;
const works = await getWorks();

// Hero slideshow: files in public/media/home/
const heroSlides = ["home/hero-1.mp4", "home/hero-2.mp4"];
---

<Layout title="Home">
	<section class="hero">
		<h1 class="display">Design Driven<br />by Purpose</h1>
		<p class="byline mono">By Tan Ming-Kai</p>

		<div class="slideshow" data-slideshow>
			{heroSlides.map((src, i) => (
				<div class="slide" data-slide hidden={i !== 0}>
					<Media src={src} alt={`Showreel clip ${i + 1}`} class="slide-media" />
				</div>
			))}
			{heroSlides.length > 1 && (
				<div class="slide-controls">
					<button type="button" data-prev aria-label="Previous clip">←</button>
					<button type="button" data-next aria-label="Next clip">→</button>
				</div>
			)}
		</div>
	</section>

	<section class="bio">
		<p data-reveal>Hands-on experience in 3D printing and general crafting with <em>5 years</em> in the cardboard craft and structural/sculptural events industry.</p>
		<p data-reveal>Practiced at typography, publication design and advertising with my <em>Communication Design Diploma</em> at Temasek Polytechnic.</p>
		<p data-reveal>My <em>Computer Science Degree</em> at SUSS complements my making background with a technical foundation useful for electronics, IT workshops, or CAD/design instruction.</p>
	</section>

	<section class="gallery" aria-label="Selected works">
		<div class="gallery-track" data-track>
			{works.map((work) => (
				<a class="gallery-item" href={`${base}works/${work.id}/`}>
					<Media
						src={workMedia(work.id, work.data.cover)}
						alt={work.data.title}
						class="gallery-media"
					/>
					<span class="gallery-caption mono">{work.data.title}</span>
				</a>
			))}
		</div>
		<button type="button" class="gallery-arrow prev" data-track-step="-1" aria-label="Previous works">←</button>
		<button type="button" class="gallery-arrow next" data-track-step="1" aria-label="More works">→</button>
	</section>
</Layout>

<style>
	/*
	 * Measured from the Wix home page. Desktop values are vw (percent of
	 * window width) so the layout is identical at every screen size.
	 */

	/* ---------- Hero ---------- */
	.hero {
		position: relative;
		height: 66.8vw;
	}
	.hero h1 {
		position: absolute;
		left: 0.5vw;
		top: 2.04vw;
		/* Inter is wider than Wix's Neue Haas Grotesk: 17.25vw gives the same width as Wix's 18.36vw,
		   and the taller line height keeps the same overall height */
		font-size: 17.25vw;
		line-height: 0.798;
		white-space: nowrap;
	}
	.byline {
		position: absolute;
		left: 1.55vw;
		top: 35.56vw;
		margin: 0;
		color: var(--orange);
		font-size: 1.875vw;
		font-weight: 400;
		line-height: 1;
	}
	.slideshow {
		position: absolute;
		left: 58.48vw;
		top: 24.13vw;
		width: 34.08vw;
		height: 36.98vw;
	}
	.slide,
	:global(.slide-media) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.slide-controls {
		position: absolute;
		bottom: 2.73vw;
		left: 0;
		right: 0;
		display: flex;
		justify-content: center;
		gap: 1.4vw;
		z-index: 1;
	}
	.slide-controls button {
		width: 2.34vw;
		height: 2.34vw;
		border: 0;
		border-radius: 50%;
		background: var(--orange);
		color: var(--bg);
		font-size: 1.1vw;
		line-height: 1;
		cursor: pointer;
	}

	/* ---------- Bio ---------- */
	.bio {
		background: var(--navy);
		min-height: 60.15vw;
		padding: 5.19vw 1.54vw;
	}
	.bio p {
		color: var(--orange);
		font-size: 3.83vw; /* Wix 4.06vw, scaled for Inter */
		line-height: 1.06;
		max-width: 91.5vw;
		margin: 0 0 1em;
	}
	.bio p:last-child {
		margin-bottom: 0;
	}
	.bio em {
		font-style: normal;
		color: #fff;
	}
	/* Blurred text sharpens as it scrolls into view (where supported) */
	@supports (animation-timeline: view()) {
		[data-reveal] {
			animation: sharpen linear both;
			animation-timeline: view();
			animation-range: entry 10% cover 35%;
		}
	}
	@keyframes sharpen {
		from {
			filter: blur(10px);
			opacity: 0.35;
		}
		to {
			filter: blur(0);
			opacity: 1;
		}
	}

	/* ---------- Gallery ---------- */
	.gallery {
		position: relative;
		padding: 4.84vw 0 4.6vw;
	}
	.gallery-track {
		display: flex;
		gap: 1.9vw;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-padding: 0 1.47vw;
		padding: 0 1.47vw;
		scrollbar-width: none;
	}
	.gallery-track::-webkit-scrollbar {
		display: none;
	}
	.gallery-item {
		position: relative;
		flex: 0 0 auto;
		scroll-snap-align: start;
		text-decoration: none;
	}
	.gallery-item :global(.gallery-media) {
		height: 33.96vw;
		width: auto;
		min-height: 0;
	}
	.gallery-item :global(img.gallery-media) {
		aspect-ratio: auto;
	}
	.gallery-item :global(.placeholder.gallery-media) {
		width: 33.96vw;
	}
	.gallery-caption {
		position: absolute;
		left: 1vw;
		bottom: 1vw;
		background: var(--orange);
		color: var(--navy);
		font-size: 0.9vw;
		font-weight: 700;
		padding: 0.3vw 0.7vw;
		border-radius: 999px;
		opacity: 0;
		transition: opacity 0.15s ease;
	}
	.gallery-item:hover .gallery-caption,
	.gallery-item:focus-visible .gallery-caption {
		opacity: 1;
	}
	.gallery-arrow {
		position: absolute;
		top: calc(4.84vw + 33.96vw / 2 - 2.97vw);
		width: 5.94vw;
		height: 5.94vw;
		border: 0;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.75);
		color: rgba(16, 16, 16, 0.6);
		font-size: 2vw;
		line-height: 1;
		cursor: pointer;
	}
	.gallery-arrow.prev {
		left: 3.19vw;
	}
	.gallery-arrow.next {
		right: 3.3vw;
	}

	/* ---------- Phones (measured from the Wix mobile layout) ---------- */
	@media (max-width: 749px) {
		.hero {
			height: auto;
			padding: 23px 20px 58px;
		}
		.hero h1 {
			position: static;
			margin-left: -10px;
			/* Wix: 22.56vw in Neue Haas, wrapping to "Design / Driven by / Purpose" */
			font-size: 21.7vw;
			line-height: 0.78;
			white-space: normal;
		}
		.hero h1 br {
			display: none;
		}
		.byline {
			position: static;
			margin-top: 17px;
			font-size: 4.6vw;
		}
		.slideshow {
			position: relative;
			left: auto;
			top: auto;
			width: 100%;
			height: auto;
			aspect-ratio: 328 / 144;
			margin-top: 39px;
		}
		.slide-controls {
			bottom: 12px;
			gap: 21px;
		}
		.slide-controls button {
			width: 28px;
			height: 28px;
			font-size: 13px;
		}
		.bio {
			min-height: 0;
			padding: 26px 19px 60px;
		}
		.bio p {
			font-size: 7.18vw;
		}
		.gallery {
			padding: 40px 23px;
		}
		.gallery-track {
			flex-direction: column;
			gap: 40px;
			overflow: visible;
			padding: 0;
		}
		.gallery-item :global(.gallery-media),
		.gallery-item :global(.placeholder.gallery-media) {
			width: 100%;
			height: auto;
		}
		.gallery-item :global(.placeholder.gallery-media) {
			aspect-ratio: 1;
		}
		.gallery-caption {
			opacity: 1;
			font-size: 11px;
			left: 10px;
			bottom: 10px;
			padding: 3px 8px;
		}
		.gallery-arrow {
			display: none;
		}
	}
</style>

<script>
	// Hero slideshow
	for (const show of document.querySelectorAll<HTMLElement>("[data-slideshow]")) {
		const slides = [...show.querySelectorAll<HTMLElement>("[data-slide]")];
		let current = 0;
		const go = (step: number) => {
			slides[current].hidden = true;
			current = (current + step + slides.length) % slides.length;
			slides[current].hidden = false;
		};
		show.querySelector("[data-prev]")?.addEventListener("click", () => go(-1));
		show.querySelector("[data-next]")?.addEventListener("click", () => go(1));
	}

	// Gallery arrows: scroll by most of a screen, wrapping at either end
	const track = document.querySelector<HTMLElement>("[data-track]");
	for (const button of document.querySelectorAll<HTMLElement>("[data-track-step]")) {
		button.addEventListener("click", () => {
			if (!track) return;
			const step = Number(button.dataset.trackStep);
			const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
			const atStart = track.scrollLeft <= 4;
			let left = step * track.clientWidth * 0.6;
			if (step > 0 && atEnd) left = -track.scrollWidth;
			if (step < 0 && atStart) left = track.scrollWidth;
			track.scrollBy({ left, behavior: "smooth" });
		});
	}
</script>
