---
/**
 * The 4-column page frame used by every page:
 *   column 1: the persistent menu (Sidebar)
 *   column 2: the info column (project / About), optional — slides in from under column 1
 *   columns 3–4 (or 2–4 when there's no info column): the scrollable image area
 */
import Sidebar from "../components/Sidebar.astro";
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
	/** "all", "about", or the current project's id: highlights it in the menu */
	active: string;
	/** Keep this page out of search engines (used for draft previews) */
	noindex?: boolean;
	/** Position in the menu (About = -1, projects 0, 1, 2…) so column 2 can
	    slide in from above or below when moving between pages */
	menuIndex?: number;
}

const {
	title,
	description = "Tan Ming-Kai — multi-disciplinary designer. Graphic design, 3D printing, and structural cardboard craft.",
	active,
	noindex = false,
	menuIndex,
} = Astro.props;
const hasInfo = Astro.slots.has("info");
---

<html lang="en" data-has-info={hasInfo ? "1" : "0"} data-menu-index={menuIndex ?? ""}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- The site is designed light-only: ask browsers' auto-dark modes and
		     dark-mode extensions (e.g. Dark Reader) not to recolour it -->
		<meta name="color-scheme" content="only light" />
		<meta name="darkreader-lock" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<meta name="generator" content={Astro.generator} />
		<title>{title === "Home" ? "Tan Ming-Kai" : `${title} | Tan Ming-Kai`}</title>
	</head>
	<body>
		<!-- The dot grid: fixed behind the image area, so it stays put while pages change -->
		<div class="dots" aria-hidden="true"></div>
		<slot name="before" />
		<div class:list={["app", hasInfo ? "app--info" : "app--wide"]} data-has-info={hasInfo ? "1" : "0"} data-menu-index={menuIndex ?? ""}>
			<Sidebar active={active} />
			{hasInfo && (
				<aside class="info" data-info>
					<slot name="info" />
				</aside>
			)}
			<main class="images" data-lightbox tabindex="-1">
				<div data-track>
					<slot />
				</div>
			</main>
		</div>

		<script>
			import PhotoSwipeLightbox from "photoswipe/lightbox";
			import "photoswipe/style.css";

			const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

			const html = document.documentElement;
			const app = document.querySelector<HTMLElement>(".app")!;
			const main = document.querySelector<HTMLElement>(".images")!;
			const dots = document.querySelector<HTMLElement>(".dots")!;

			// Parallax: the dot grid moves at half the scroll speed. `dotLag` eases it
			// back into line after a page change scrolls to the top.
			let dotLag = 0;
			const placeDots = () => dots.style.setProperty("--dot-shift", `${(-(scrollY * 0.5) - dotLag).toFixed(1)}px`);
			if (!reduceMotion) {
				let ticking = false;
				addEventListener("scroll", () => {
					if (!ticking) {
						ticking = true;
						requestAnimationFrame(() => {
							placeDots();
							ticking = false;
						});
					}
				}, { passive: true });
				placeDots();
			}

			// Ambient videos only load and play while on screen
			const observer = new IntersectionObserver((entries) => {
				for (const { target, isIntersecting } of entries) {
					const video = target as HTMLVideoElement;
					if (isIntersecting && !reduceMotion) video.play().catch(() => {});
					else video.pause();
				}
			}, { rootMargin: "200px" });
			const watchVideos = (root: ParentNode) => {
				for (const video of root.querySelectorAll("video[data-ambient]")) observer.observe(video);
			};
			watchVideos(document);

			// "Sound on" buttons: unmute one video at a time
			document.addEventListener("click", (event) => {
				const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-sound-toggle]");
				if (!button) return;
				const turnOn = button.getAttribute("aria-pressed") !== "true";
				for (const other of document.querySelectorAll<HTMLButtonElement>("[data-sound-toggle]")) {
					other.setAttribute("aria-pressed", "false");
					other.textContent = "Sound on";
					(other.previousElementSibling as HTMLVideoElement).muted = true;
				}
				if (turnOn) {
					const video = button.previousElementSibling as HTMLVideoElement;
					video.muted = false;
					video.play().catch(() => {});
					button.setAttribute("aria-pressed", "true");
					button.textContent = "Sound off";
				}
			});

			// ---------- Moving between pages ----------
			// Menu and collage links load the next page in place, so the old columns can
			// slide out while the new ones slide in. Direction follows the menu:
			//   All → project/About: column 2 slides in from the left, images move up
			//   page → page: a page higher in the menu comes from above, a lower one from below
			//   project/About → All: column 2 slides back left, images move down
			const DURATION = 900;
			const IMAGES_LAG = 200; // the images start moving just after column 2
			const EASE = "cubic-bezier(0.65, 0, 0.35, 1)";

			const pages = new Map<string, Promise<Document>>();
			const fetchPage = (url: string) => {
				const key = url.split("#")[0];
				if (!pages.has(key)) {
					const page = fetch(key)
						.then((response) => {
							if (!response.ok) throw new Error(String(response.status));
							return response.text();
						})
						.then((text) => new DOMParser().parseFromString(text, "text/html"));
					page.catch(() => pages.delete(key));
					pages.set(key, page);
				}
				return pages.get(key)!;
			};
			// Start loading on hover, so the click feels instant
			document.addEventListener("pointerover", (event) => {
				const link = (event.target as HTMLElement).closest<HTMLAnchorElement>("a[data-nav]");
				if (link) fetchPage(link.href).catch(() => {});
			});

			let running: Animation[] = [];
			// Outgoing pieces hold their end position and are removed as soon as their
			// own slide ends, so they never snap back over the new page
			const slide = (el: Element, from: string, to: string, fade = false, delay = 0) => {
				const leavingPage = from === "none";
				const animation = el.animate(
					[
						{ transform: from, ...(fade && { opacity: to === "none" ? 0 : 1 }) },
						{ transform: to, ...(fade && { opacity: to === "none" ? 1 : 0 }) },
					],
					{ duration: DURATION, easing: EASE, delay, fill: leavingPage ? "both" : "backwards" },
				);
				if (leavingPage) animation.addEventListener("finish", () => el.remove());
				running.push(animation);
				return animation;
			};

			// Pin an element where it is on screen, so it can slide away after the page changes
			const pinInPlace = (el: HTMLElement) => {
				const rect = el.getBoundingClientRect();
				Object.assign(el.style, {
					position: "fixed",
					top: `${rect.top}px`,
					left: `${rect.left}px`,
					width: `${rect.width}px`,
					height: `${rect.height}px`,
					margin: "0",
					pointerEvents: "none",
				});
				app.append(el);
			};

			// Pin the on-screen part of some images in a fixed layer, so they can slide
			// away while new ones take their place
			const pinImages = (el: HTMLElement, rect: DOMRect) => {
				const layer = document.createElement("div");
				layer.className = "images-leaving";
				layer.setAttribute("aria-hidden", "true");
				Object.assign(layer.style, {
					position: "fixed",
					top: "0",
					left: `${rect.left}px`,
					width: `${rect.width}px`,
					height: "100vh",
					overflow: "hidden",
					pointerEvents: "none",
				});
				el.style.transform = `translateY(${rect.top}px)`;
				layer.append(el);
				app.append(layer);
				return layer;
			};

			// Get the first few photos loaded before they slide in, so they don't pop in
			// halfway (gives up after a second, so a slow connection never stalls a click)
			const readyPhotos = (imgs: HTMLImageElement[]) => {
				const first = imgs.slice(0, 6);
				for (const img of first) img.loading = "eager";
				return Promise.race([
					Promise.all(first.map((img) => img.decode().catch(() => {}))),
					new Promise((done) => setTimeout(done, 1000)),
				]);
			};

			// After a jump back to the top, ease the dots into line instead of jumping
			const settleDots = (lag: number, delay: number) => {
				const start = performance.now();
				const settle = (now: number) => {
					const t = Math.min(1, Math.max(0, now - start - delay) / DURATION);
					dotLag = (lag - scrollY * 0.5) * (1 - (t < 0.5 ? 4 * t ** 3 : 1 - (-2 * t + 2) ** 3 / 2));
					placeDots();
					if (t < 1) requestAnimationFrame(settle);
				};
				dotLag = lag;
				requestAnimationFrame(settle);
			};

			let currentPath = location.pathname;
			history.scrollRestoration = "manual";

			const go = async (url: string, push: boolean) => {
				let doc: Document;
				try {
					doc = await fetchPage(url);
				} catch {
					location.assign(url);
					return;
				}
				const nextApp = doc.querySelector<HTMLElement>(".app");
				const nextTrack = doc.querySelector<HTMLElement>("[data-track]");
				if (!nextApp || !nextTrack) {
					location.assign(url);
					return;
				}
				// Each page type has its own styles in <head>: add any this page hasn't got yet
				// (and wait for new stylesheet files, so nothing shows unstyled)
				const styleKey = (el: Element) =>
					el instanceof HTMLLinkElement ? el.href : el.getAttribute("data-vite-dev-id") ?? el.textContent;
				const have = new Set([...document.head.querySelectorAll('style, link[rel="stylesheet"]')].map(styleKey));
				const loading: Promise<unknown>[] = [];
				for (const el of doc.head.querySelectorAll('style, link[rel="stylesheet"]')) {
					if (have.has(styleKey(el))) continue;
					const copy = document.importNode(el, true);
					if (copy instanceof HTMLLinkElement) {
						loading.push(new Promise((done) => {
							copy.addEventListener("load", done);
							copy.addEventListener("error", done);
						}));
					}
					document.head.append(copy);
				}
				await Promise.all(loading);

				const newTrack = document.importNode(nextTrack, true);
				await readyPhotos([...newTrack.querySelectorAll("img")].filter((img) => !img.closest("[hidden]")));

				for (const animation of running) animation.finish();
				running = [];

				// Which way things move
				const fromInfo = html.dataset.hasInfo === "1";
				const toInfo = doc.documentElement.dataset.hasInfo === "1";
				const fromIndex = Number(html.dataset.menuIndex);
				const toIndex = Number(doc.documentElement.dataset.menuIndex);
				const up = toInfo ? !fromInfo || toIndex > fromIndex : false; // new content arrives from below

				// Where the dots are now (read before the page shortens and the scroll resets)
				const lag = scrollY * 0.5 + dotLag;

				// Old images: clip to what's on screen, pin there
				const oldTrack = main.querySelector<HTMLElement>("[data-track]")!;
				oldTrack.removeAttribute("data-track");
				const leaving = pinImages(oldTrack, oldTrack.getBoundingClientRect());

				// Old column 2: pin it too
				const oldInfo = app.querySelector<HTMLElement>(":scope > .info");
				if (oldInfo) pinInPlace(oldInfo);

				// Swap in the new page
				scrollTo(0, 0);
				for (const el of [...document.body.children]) if (el !== dots && el.compareDocumentPosition(app) & Node.DOCUMENT_POSITION_FOLLOWING) el.remove();
				for (const el of [...doc.body.children]) {
					if (el === nextApp) break;
					if (!el.matches(".dots, script")) app.before(document.importNode(el, true));
				}
				app.className = nextApp.className;
				html.dataset.hasInfo = doc.documentElement.dataset.hasInfo;
				html.dataset.menuIndex = doc.documentElement.dataset.menuIndex;
				document.title = doc.title;
				const description = doc.querySelector<HTMLMetaElement>('meta[name="description"]')?.content;
				if (description) document.querySelector<HTMLMetaElement>('meta[name="description"]')?.setAttribute("content", description);

				// Menu: move the highlight (and fold the phone menu away)
				const nextLinks = [...nextApp.querySelectorAll(".sidebar a")];
				document.querySelectorAll(".sidebar a").forEach((link, i) => {
					const current = nextLinks[i]?.getAttribute("aria-current");
					if (current) link.setAttribute("aria-current", current);
					else link.removeAttribute("aria-current");
				});
				const sidebar = document.querySelector<HTMLElement>("[data-sidebar]");
				if (sidebar?.classList.contains("open")) sidebar.querySelector<HTMLButtonElement>("[data-sidebar-toggle]")?.click();

				const nextInfo = nextApp.querySelector<HTMLElement>(":scope > .info");
				const newInfo = nextInfo ? document.importNode(nextInfo, true) : null;
				if (newInfo) main.before(newInfo);
				main.append(newTrack);

				if (push) history.pushState(null, "", url);
				currentPath = location.pathname;
				if (location.hash) openFromHash();
				watchVideos(newTrack);
				if (!(document.activeElement instanceof HTMLElement) || !document.activeElement.isConnected || document.activeElement === document.body) main.focus({ preventScroll: true });

				// Slide: old out, new in, at the same time
				const out = up ? "translateY(-100vh)" : "translateY(100vh)";
				const into = up ? "translateY(100vh)" : "translateY(-100vh)";
				slide(leaving, "none", out, true, IMAGES_LAG);
				slide(newTrack, into, "none", true, IMAGES_LAG);
				if (oldInfo && newInfo) {
					slide(oldInfo, "none", up ? "translateY(-100%)" : "translateY(100%)");
					slide(newInfo, up ? "translateY(100%)" : "translateY(-100%)", "none");
				} else if (oldInfo) {
					slide(oldInfo, "none", "translateX(-100%)");
				} else if (newInfo) {
					slide(newInfo, "translateX(-100%)", "none");
				}

				settleDots(lag, IMAGES_LAG);
			};

			// Tabs projects: the Pieces list (column 2) switches which piece's photos show,
			// and which blurb shows in the info card. Opens on "All"; #piece links work.
			// When clicked, the photos slide like a page change: a piece further down the
			// list comes up from below, one higher up comes down from above.
			let pieceRequest = 0;
			const selectPiece = async (id: string, updateUrl: boolean, animate = false) => {
				const request = ++pieceRequest;
				const tabs = [...document.querySelectorAll<HTMLElement>("[data-piece-tab]")];
				for (const tab of tabs) tab.setAttribute("aria-selected", String(tab.dataset.pieceTab === id));
				const panels = [...document.querySelectorAll<HTMLElement>("[data-track] [data-piece]")];
				const panel = panels.find((p) => p.dataset.piece === id);
				if (!panel) return;
				if (animate) await readyPhotos([...panel.querySelectorAll("img")]);
				if (request !== pieceRequest) return; // another piece was clicked meanwhile
				const oldPanel = panels.find((p) => !p.hidden);
				if (panel === oldPanel) return;
				for (const animation of running) animation.finish();
				running = [];

				const order = (pieceId?: string) => tabs.findIndex((t) => t.dataset.pieceTab === pieceId);
				const up = order(id) > order(oldPanel?.dataset.piece);
				let leaving: HTMLElement | null = null;
				const lag = scrollY * 0.5 + dotLag;
				if (animate && oldPanel) {
					const copy = oldPanel.cloneNode(true) as HTMLElement;
					copy.removeAttribute("id");
					leaving = pinImages(copy, oldPanel.getBoundingClientRect());
				}

				for (const p of panels) p.hidden = p !== panel;
				for (const blurb of document.querySelectorAll<HTMLElement>("[data-piece-info]")) blurb.hidden = blurb.dataset.pieceInfo !== id;
				for (const video of document.querySelectorAll<HTMLVideoElement>("[data-piece][hidden] video")) video.pause();
				if (updateUrl) history.replaceState(history.state, "", `#${id}`);

				// Show the new piece's photos from the top
				if (leaving) {
					scrollTo(0, 0);
					slide(leaving, "none", up ? "translateY(-100vh)" : "translateY(100vh)", true);
					slide(panel, up ? "translateY(100vh)" : "translateY(-100vh)", "none", true);
					settleDots(lag, 0);
				} else if (panel.getBoundingClientRect().top < 0) {
					scrollTo({ top: 0 });
				}
			};
			document.addEventListener("click", (event) => {
				const tab = (event.target as HTMLElement).closest<HTMLElement>("[data-piece-tab]");
				if (tab) selectPiece(tab.dataset.pieceTab!, true, !reduceMotion);
			});
			const openFromHash = () => {
				const id = decodeURIComponent(location.hash.slice(1));
				const tab = id && document.querySelector(`[data-piece-tab="${CSS.escape(id)}"]`);
				if (tab) {
					selectPiece(id, false);
					tab.scrollIntoView({ block: "nearest" });
				}
			};
			openFromHash();
			addEventListener("hashchange", openFromHash);

			if (!reduceMotion) {
				document.addEventListener("click", (event) => {
					const link = (event.target as HTMLElement).closest<HTMLAnchorElement>("a[data-nav]");
					if (!link) return;
					if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
					if ((link.target && link.target !== "_self") || link.origin !== location.origin) return;
					if (link.pathname === location.pathname) return; // same page: let a #piece link work as normal
					event.preventDefault();
					go(link.href, true);
				});
				addEventListener("popstate", () => {
					if (location.pathname !== currentPath) go(location.href, false);
				});
			}

			// Full-screen viewer for any linked image. Arrow keys move, Esc closes.
			const lightbox = new PhotoSwipeLightbox({
				gallery: "[data-lightbox]",
				// Skip photos in hidden pieces (Tabs projects)
				children: "a.lightbox-link:not([hidden] a)",
				pswpModule: () => import("photoswipe"),
				bgOpacity: 0.94,
				showHideAnimationType: reduceMotion ? "none" : "zoom",
				showAnimationDuration: reduceMotion ? 0 : 250,
				hideAnimationDuration: reduceMotion ? 0 : 250,
				zoomAnimationDuration: reduceMotion ? 0 : 250,
				// Keep the close/arrow buttons on screen at all times
				idleTime: 1e9,
				tapAction: "close",
				closeTitle: "Close (Esc)",
				arrowPrevTitle: "Previous (left arrow)",
				arrowNextTitle: "Next (right arrow)",
			});
			lightbox.addFilter("domItemData", (itemData, element) => {
				const img = element.querySelector("img");
				if (img) {
					itemData.alt = img.alt;
					itemData.thumbCropped = true;
				}
				return itemData;
			});
			lightbox.on("uiRegister", () => {
				lightbox.pswp?.ui?.registerElement({
					name: "caption",
					order: 9,
					isButton: false,
					appendTo: "root",
					onInit: (el, pswp) => {
						pswp.on("change", () => {
							const link = pswp.currSlide?.data.element;
							const caption = link?.closest("figure")?.querySelector("figcaption")?.textContent;
							el.textContent = caption || pswp.currSlide?.data.alt || "";
						});
					},
				});
			});
			lightbox.init();
		</script>
	</body>
</html>

<style>
	/* ---------- The column grid (desktop) ---------- */
	.app {
		display: grid;
		min-height: 100vh;
		align-items: start;
	}
	.app--info {
		grid-template-columns: 20.5vw 24.5vw minmax(0, 1fr);
	}
	.app--wide {
		grid-template-columns: 20.5vw minmax(0, 1fr);
	}

	/* Column 2: pinned full height; its own sections scroll inside it */
	.info {
		position: sticky;
		top: 0;
		z-index: 2;
		height: 100vh;
		display: flex;
		flex-direction: column;
		min-width: 0;
		padding: 1vw 1.1vw 1vw 1vw;
		background: var(--bg);
		font-family: var(--font-mono);
		color: var(--navy);
	}
	/* Image area: transparent so the fixed dot grid shows through */
	.images {
		position: relative;
		min-width: 0;
		min-height: 100vh;
		padding: 1vw 1.1vw 3vw;
		color: var(--navy);
	}
	.images:focus {
		outline: none;
	}

	/* Dot grid, fixed behind the image area (same dot density as the old offset
	   grid). --dot-shift is set while scrolling (parallax: half speed) */
	.dots {
		position: fixed;
		inset: 0 0 0 20.5vw;
		pointer-events: none;
		background-image: radial-gradient(circle, var(--navy) 0.06vw, transparent 0.075vw);
		background-size: 0.78vw 0.78vw;
		background-position: 0 var(--dot-shift, 0px);
	}


	/* Full-screen viewer (PhotoSwipe) caption and controls, in the site's colours */
	:global(.pswp__caption) {
		position: absolute;
		left: 50%;
		bottom: 16px;
		transform: translateX(-50%);
		max-width: min(90vw, 760px);
		padding: 8px 14px;
		background: var(--navy);
		color: #fff;
		font-family: var(--font-mono);
		font-size: 14px;
		line-height: 1.4;
		text-align: center;
	}
	:global(.pswp__caption:empty) {
		display: none;
	}
	:global(.pswp__button) {
		min-width: 44px;
		min-height: 44px;
	}
	:global(.pswp--idle .pswp__top-bar),
	:global(.pswp--idle .pswp__button--arrow) {
		opacity: 1 !important;
	}
	:global(.pswp__button:focus-visible) {
		outline: 3px solid var(--orange);
		outline-offset: -3px;
	}

	/* ---------- Phones: menu bar on top, then the info, then the images ---------- */
	@media (max-width: 899px) {
		.app,
		.app--info,
		.app--wide {
			display: block;
		}
		.info {
			position: relative; /* stays above the dot grid */
			height: auto;
			padding: 16px;
		}
		.images {
			min-height: 0;
			padding: 12px 16px 40px;
		}
		.dots {
			inset: 0;
			background-image: radial-gradient(circle, var(--navy) 0.8px, transparent 1px);
			background-size: 10px 10px;
		}
	}
</style>
