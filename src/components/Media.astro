---
/**
 * Shows an image or video from public/media/. If the file isn't there yet,
 * renders a labelled placeholder so you can see where it needs to go.
 *
 * Images go through Astro's <Picture />, which generates AVIF/WebP at several
 * widths and sets width/height so nothing shifts while loading. The files stay
 * in public/media (where Pages CMS uploads them); import.meta.glob lets Astro
 * process them from there.
 */
import fs from "node:fs";
import path from "node:path";
import { Picture } from "astro:assets";

const images = import.meta.glob<{ default: ImageMetadata }>(
	"/public/media/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}",
	{ eager: true },
);

interface Props {
	/** Path inside public/media/, e.g. "works/uniqlo-sustainability-pop-up/cover.jpg" */
	src: string;
	alt?: string;
	class?: string;
	/** Video only: play muted on loop like a GIF (default true) */
	ambient?: boolean;
	/** Video only: has a soundtrack worth hearing, so show a "Sound on" button */
	sound?: boolean;
	/** Image only: load immediately with high priority (use for the top image only) */
	eager?: boolean;
	/** Image only: the `sizes` hint, i.e. how wide the image is shown */
	sizes?: string;
	/** Image only: widths to generate */
	widths?: number[];
	/** Image only: wrap in a link that opens the full-screen viewer */
	lightbox?: boolean;
}

const {
	src,
	alt = "",
	class: className,
	ambient = true,
	sound = false,
	eager = false,
	sizes = "100vw",
	widths = [480, 800, 1200, 1600],
	lightbox = false,
} = Astro.props;
const exists = fs.existsSync(path.join(process.cwd(), "public", "media", src));
const url = `${import.meta.env.BASE_URL}media/${src}`;
const isVideo = /\.(mp4|webm|mov)$/i.test(src);
const image = images[`/public/media/${src}`]?.default;
const usableWidths = image ? [...widths.filter((w) => w < image.width), image.width] : [];
// Stable name for page-to-page transitions: the same photo on two pages glides
// between them (names are switched on for on-screen photos by AppShell's script)
let hash = 5381;
for (const ch of src) hash = ((hash * 33) ^ ch.charCodeAt(0)) >>> 0;
const vt = `vt-${hash.toString(36)}`;
---

{!exists ? (
	<div class:list={["placeholder", className]} role="img" aria-label={alt}>
		<span class="mono">media/{src}</span>
	</div>
) : isVideo ? (
	ambient && sound ? (
		<div class:list={["sound-wrap", className]}>
			<video src={url} data-ambient data-vt={vt} muted loop playsinline preload="metadata" aria-label={alt} />
			<button type="button" class="sound-toggle mono" data-sound-toggle aria-pressed="false">Sound on</button>
		</div>
	) : ambient ? (
		<video class={className} src={url} data-ambient data-vt={vt} muted loop playsinline preload="metadata" aria-label={alt} />
	) : (
		<video class={className} src={url} controls playsinline aria-label={alt} />
	)
) : image && lightbox ? (
	<a
		href={url}
		class:list={["lightbox-link", className]}
		data-pswp-width={image.width}
		data-pswp-height={image.height}
		aria-label={alt ? `View larger: ${alt}` : "View larger"}
	>
		<Picture
			src={image}
			alt={alt}
			widths={usableWidths}
			sizes={sizes}
			formats={["avif", "webp"]}
			loading={eager ? "eager" : "lazy"}
			fetchpriority={eager ? "high" : "auto"}
			pictureAttributes={{ style: "display: contents" }}
			data-vt={vt}
		/>
	</a>
) : image ? (
	<Picture
		src={image}
		alt={alt}
		class={className}
		widths={usableWidths}
		sizes={sizes}
		formats={["avif", "webp"]}
		loading={eager ? "eager" : "lazy"}
		fetchpriority={eager ? "high" : "auto"}
		pictureAttributes={{ style: "display: contents" }}
		data-vt={vt}
	/>
) : (
	<img class:list={["plain-img", className]} src={url} alt={alt} loading={eager ? "eager" : "lazy"} decoding="async" />
)}

<style>
	.placeholder {
		display: flex;
		align-items: flex-end;
		background: var(--placeholder);
		min-height: 160px;
		padding: 0.6rem;
		color: #7a7a7a;
		font-size: 0.65rem;
		overflow-wrap: anywhere;
	}
	img,
	video {
		object-fit: cover;
	}
	/* Images without known dimensions: reserve a square until they load */
	.plain-img {
		aspect-ratio: auto 1 / 1;
	}
	.lightbox-link {
		display: block;
		cursor: zoom-in;
	}
	.lightbox-link img {
		display: block;
		width: 100%;
		height: 100%;
	}
	.lightbox-link:focus-visible {
		outline: 3px solid var(--navy);
		outline-offset: 2px;
	}
	.sound-wrap {
		position: relative;
	}
	.sound-wrap video {
		width: 100%;
		height: auto;
	}
	.sound-toggle {
		position: absolute;
		right: 0.6rem;
		bottom: 0.6rem;
		min-height: 44px;
		background: var(--orange);
		color: var(--navy);
		border: 0;
		border-radius: 999px;
		font-size: 0.7rem;
		font-weight: 700;
		padding: 0.3rem 0.9rem;
		cursor: pointer;
	}
</style>
