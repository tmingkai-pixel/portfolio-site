---
/**
 * Shows an image or video from public/media/. If the file isn't there yet,
 * renders a labelled placeholder so you can see where it needs to go.
 */
import fs from "node:fs";
import path from "node:path";

interface Props {
	/** Path inside public/media/, e.g. "works/uniqlo-sustainability-pop-up/cover.jpg" */
	src: string;
	alt?: string;
	class?: string;
	/** Video only: play muted on loop like a GIF (default true) */
	ambient?: boolean;
	/** Video only: has a soundtrack worth hearing, so show a "Sound on" button */
	sound?: boolean;
	/** Image only: load immediately instead of when scrolled near (use for the top image) */
	eager?: boolean;
}

const { src, alt = "", class: className, ambient = true, sound = false, eager = false } = Astro.props;
const exists = fs.existsSync(path.join(process.cwd(), "public", "media", src));
const url = `${import.meta.env.BASE_URL}media/${src}`;
const isVideo = /\.(mp4|webm|mov)$/i.test(src);
---

{!exists ? (
	<div class:list={["placeholder", className]} role="img" aria-label={alt}>
		<span class="mono">media/{src}</span>
	</div>
) : isVideo ? (
	ambient && sound ? (
		<div class:list={["sound-wrap", className]}>
			<video src={url} data-ambient muted loop playsinline preload="metadata" aria-label={alt} />
			<button type="button" class="sound-toggle mono" data-sound-toggle aria-pressed="false">Sound on</button>
		</div>
	) : ambient ? (
		<video class={className} src={url} data-ambient muted loop playsinline preload="metadata" aria-label={alt} />
	) : (
		<video class={className} src={url} controls playsinline aria-label={alt} />
	)
) : (
	<img class={className} src={url} alt={alt} loading={eager ? "eager" : "lazy"} decoding="async" />
)}

<style>
	.placeholder {
		display: flex;
		align-items: flex-end;
		background: var(--placeholder);
		min-height: 160px;
		padding: 0.6rem;
		color: #7a7a7a;
		font-size: 0.65rem;
		overflow-wrap: anywhere;
	}
	img,
	video {
		object-fit: cover;
	}
	/* Reserve a square until the real size is known, so lazy images aren't 0px tall */
	img {
		aspect-ratio: auto 1 / 1;
	}
	.sound-wrap {
		position: relative;
	}
	.sound-wrap video {
		width: 100%;
		height: auto;
	}
	.sound-toggle {
		position: absolute;
		right: 0.6rem;
		bottom: 0.6rem;
		background: var(--orange);
		color: var(--navy);
		border: 0;
		border-radius: 999px;
		font-size: 0.65rem;
		font-weight: 700;
		padding: 0.3rem 0.7rem;
		cursor: pointer;
	}
</style>
