---
/**
 * Previous / next project links as an "index card": a dashed box with the
 * neighbouring titles on either side and the project's number in the middle.
 */
import type { CollectionEntry } from "astro:content";

interface Props {
	prev?: CollectionEntry<"works">;
	next?: CollectionEntry<"works">;
	/** This project's position in the Works order (1-based); missing for drafts */
	position?: number;
	total?: number;
	/** Small version that sits at the bottom of the pinned text column */
	compact?: boolean;
}

const { prev, next, position, total, compact = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const pad = (n: number) => String(n).padStart(2, "0");
const counter = position && total ? `No. ${pad(position)} / ${pad(total)}` : "Draft";
---

{(prev || next) && (
	<nav class:list={["pager", compact && "pager--compact"]} aria-label="More works">
		{prev ? (
			<a class="pager-link pager-link--prev" href={`${base}works/${prev.id}/`}>
				<span aria-hidden="true">←</span>
				<span class="visually-hidden">Previous project:</span>
				<span class="pager-title">{prev.data.title}</span>
			</a>
		) : <span />}
		<span class="pager-counter">{counter}</span>
		{next ? (
			<a class="pager-link pager-link--next" href={`${base}works/${next.id}/`}>
				<span class="visually-hidden">Next project:</span>
				<span class="pager-title">{next.data.title}</span>
				<span aria-hidden="true">→</span>
			</a>
		) : <span />}
	</nav>
)}

<style>
	/* Index card: dashed navy box, text centred vertically, counter in the middle */
	.pager {
		--pad-y: 1.1em;
		--pad-x: 1.6em;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: stretch;
		column-gap: 1.5em;
		margin-top: 5vw;
		padding: 0 var(--pad-x);
		/* The dashes always use the text colour, even if a browser
		   extension (e.g. a dark-mode tool) recolours the text */
		color: var(--navy);
		border: 2px dashed currentColor;
		border-radius: 3px;
		font-family: var(--font-mono);
		font-size: 1.1vw;
		line-height: 1.2;
		letter-spacing: 0.01em;
	}
	.pager > * {
		display: flex;
		align-items: center;
		min-width: 0;
	}
	.pager-link {
		gap: 0.6em;
		/* Padding lives on the links so the whole height of the box is clickable */
		padding: var(--pad-y) 0;
		min-height: 44px;
		color: inherit;
		text-decoration: none;
	}
	.pager-link--next {
		justify-content: flex-end;
		text-align: right;
	}
	.pager-title {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.pager-link:hover .pager-title {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.pager-link:focus-visible {
		outline: 2px solid var(--orange);
		outline-offset: 2px;
	}
	.pager-counter {
		justify-content: center;
		color: var(--orange);
		font-weight: 400;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		white-space: nowrap;
	}
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	/* Compact: at the bottom of the pinned text column, sized with that column */
	.pager--compact {
		--pad-y: 0.95em;
		--pad-x: 1.3em;
		margin-top: calc(1.6vh * var(--fit, 1));
		font-size: calc(min(0.85vw, 1.45vh) * var(--fit, 1));
	}

	/* Phones: counter on its own line, so both titles get the full width */
	@media (max-width: 749px) {
		.pager {
			--pad-y: 12px;
			--pad-x: 14px;
			grid-template-columns: 1fr 1fr;
			grid-template-areas:
				"counter counter"
				"prev next";
			column-gap: 12px;
			margin-top: 40px;
			padding-top: 12px;
			font-size: 13px;
		}
		.pager-counter {
			grid-area: counter;
			font-size: 12px;
		}
		.pager > :first-child {
			grid-area: prev;
		}
		.pager > :last-child {
			grid-area: next;
		}
		.pager-title {
			white-space: normal;
		}
	}
</style>
